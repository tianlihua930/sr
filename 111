  <main>
    <section class="arrival" id="arrival" aria-labelledby="invitation-title" hidden=""><div class="invitation-copy"><div class="manor-trim trim-top" aria-hidden="true">❦ <span>◇ · ✧ · ◇</span> ❦</div>
